     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Check"}]}], " ", "for", " ", "data", " ", "file"}], ",", 
     
     RowBox[{
      RowBox[{"then", " ", "load", " ", "or", " ", "generate", " ", "as", " ", 
       RowBox[{"needed", "--"}]}], "-"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"FileExistsQ", "[", "dataFilename", "]"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"If", " ", "file", " ", "exists"}], ",", 
        RowBox[{"load", " ", "it", " ", "instantly"}]}], "*)"}], 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Loading pre-computed data from \\\"\>\"", ",", 
         "dataFilename", ",", "\"\<\\\"...\>\""}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"bValues", ",", "tValues"}], "}"}], "=", 
        RowBox[{"Import", "[", 
         RowBox[{"dataFilename", ",", "\"\<MX\>\""}], "]"}]}], ";"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"If", " ", "file", " ", 
         RowBox[{"doesn", "'"}], "t", " ", "exist"}], ",", 
        RowBox[{
         RowBox[{"run", " ", "the", " ", "one"}], "-", 
         RowBox[{
         "time", " ", "generation", " ", "and", " ", "save", " ", "it"}]}]}], 
       "*)"}], 
      RowBox[{
       RowBox[{
       "Print", 
        "[", "\"\<No data file found. Generating new data... (this may take a \
moment)\>\"", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"bValues", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"bMin", ",", "bMax", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"bMax", "-", "bMin"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"numPoints", "-", "1"}], ")"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tValues", "=", 
        RowBox[{"Monitor", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"mfptSingleIntegral", "[", "b", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"b", ",", "bValues"}], "}"}]}], "]"}], ",", 
          RowBox[{"StringForm", "[", 
           RowBox[{"\"\<Calculating for b = ``\>\"", ",", 
            RowBox[{"N", "[", 
             RowBox[{"b", ",", "4"}], "]"}]}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{"dataFilename", ",", 
