Cell[BoxData[{"intMSFull", "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"highProportion", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "highProportion"}], ")"}], "*", "intMSFull"}], "/.",
           "x0Rule"}], "/.", 
         RowBox[{"s", "->", "lowS"}]}]}], "}"}], "/.", "table"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"highProportion", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"highProportion", "*", "intMSFull"}], "/.", "x0Rule"}], "/.", 
         RowBox[{"s", "->", "highS"}]}]}], "}"}], "/.", "table"}]}], "}"}], ",", 
   RowBox[{"Joined", "->", "True"}], ",", 
   RowBox[{"Epilog", "->", 
    RowBox[{"{", 
     RowBox[{"Dotted", ",", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "pureS"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "pureS"}], "}"}]}], "}"}], "]"}]}], "}"}]}], ",", 
   
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<low S\>\"", ",", "\"\<high S\>\""}], "}"}]}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<low S\>\"", ",", "\"\<high S\>\""}], "}"}]}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
