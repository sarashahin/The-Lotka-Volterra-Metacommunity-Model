Cell[BoxData[
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"ii", "=", "1"}], ",", 
    RowBox[{"ii", "<", "1000"}], ",", 
    RowBox[{"ii", "++"}], ",", 
    RowBox[{
     RowBox[{"abundance1", "=", 
      RowBox[{"alpha1", "*", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#1", "[", 
           RowBox[{"[", "#2", "]"}], "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"abundanceHigh", "[", "oneProp", "]"}], ",", 
              RowBox[{"abundanceLow", "[", 
               RowBox[{"1", "-", "oneProp"}], "]"}]}], "}"}], "//", 
            "Transpose"}], ",", "env"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"abundance2", "=", 
      RowBox[{"alpha2", "*", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#1", "[", 
           RowBox[{"[", "#2", "]"}], "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"abundanceLow", "[", "oneProp", "]"}], ",", 
              RowBox[{"abundanceHigh", "[", 
               RowBox[{"1", "-", "oneProp"}], "]"}]}], "}"}], "//", 
            "Transpose"}], ",", "env"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"incoming1", "=", 
      RowBox[{
       RowBox[{"InverseFourier", "[", 
        RowBox[{
         RowBox[{"Fourier", "[", "abundance1", "]"}], "*", 
         RowBox[{"Fourier", "[", "yKernel", "]"}]}], "]"}], "//", "Chop"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"incoming2", "=", 
      RowBox[{
       RowBox[{"InverseFourier", "[", 
        RowBox[{
         RowBox[{"Fourier", "[", "abundance2", "]"}], "*", 
         RowBox[{"Fourier", "[", "yKernel", "]"}]}], "]"}], "//", "Chop"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"oneProp", "=", 
      RowBox[{"incoming1", "/", 
       RowBox[{"(", 
        RowBox[{"incoming1", "+", "incoming2"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"alpha1", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", "[", 
          RowBox[{"[", "#2", "]"}], "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"durationHigh", "[", "oneProp", "]"}], ",", 
             RowBox[{"durationLow", "[", 
              RowBox[{"1", "-", "oneProp"}], "]"}]}], "}"}], "//", 
           "Transpose"}], ",", "env"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"alpha2", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", "[", 
          RowBox[{"[", "#2", "]"}], "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"durationLow", "[", "oneProp", "]"}], ",", 
             RowBox[{"durationHigh", "[", 
              RowBox[{"1", "-", "oneProp"}], "]"}]}], "}"}], "//", 
           "Transpose"}], ",", "env"}], "}"}]}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]"}]], "Input",
