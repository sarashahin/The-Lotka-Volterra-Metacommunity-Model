Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["x0", "2"], 
       RowBox[{"2", " ", 
        SuperscriptBox["SD", "2"]}]]}]], " ", 
    SqrtBox[
     FractionBox["2", "\[Pi]"]], " ", "SD"}], "+", "x0", "+", 
   RowBox[{"x0", " ", 
    RowBox[{"Erf", "[", 
     FractionBox["x0", 
      RowBox[{
       SqrtBox["2"], " ", "SD"}]], "]"}]}], "+", 
   RowBox[{"2", " ", "x0", " ", 
    RowBox[{"fastMFPT", "[", 
     FractionBox["x0", "SD"], "]"}]}]}], 
  RowBox[{"2", " ", "rho"}]]], "Output",
 CellChangeTimes->{3.975643128060635*^9},
 CellLabel->
  "Out[650]=",ExpressionUUID->"96a18f90-fb23-4545-b0da-5b2a8f47a89b"],

