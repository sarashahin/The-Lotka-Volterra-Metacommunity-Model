Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"uMRule", "=", 
  RowBox[{
   RowBox[{"uMRule0", "/.", "c1RuleM"}], "//", "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.9668499962660637`*^9, 3.9668500048344584`*^9}, 
   3.966850257844491*^9},
 CellLabel->"In[42]:=",ExpressionUUID->"0fc70ded-d822-4392-ab3d-8048e0ca4ed2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"u", "[", "x", "]"}], "\[Rule]", 
   RowBox[{
    FractionBox["x", "rho"], "+", 
    FractionBox[
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       FractionBox[
        RowBox[{"rho", " ", 
         SuperscriptBox["x0", "2"]}], 
        SuperscriptBox["sig", "2"]]], " ", 
      SqrtBox["\[Pi]"], " ", "x0", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          FractionBox[
           RowBox[{"rho", " ", "x", " ", 
            RowBox[{"(", 
             RowBox[{"x", "-", 
              RowBox[{"2", " ", "x0"}]}], ")"}]}], 
           SuperscriptBox["sig", "2"]]], " ", 
         RowBox[{"DawsonF", "[", 
          FractionBox[
           RowBox[{
            SqrtBox["rho"], " ", 
            RowBox[{"(", 
             RowBox[{"x", "-", "x0"}], ")"}]}], "sig"], "]"}]}], "+", 
        RowBox[{"DawsonF", "[", 
         FractionBox[
          RowBox[{
           SqrtBox["rho"], " ", "x0"}], "sig"], "]"}]}], ")"}]}], "rho"], "+", 
    RowBox[{
     FractionBox["1", 
      SuperscriptBox["sig", "2"]], 
     RowBox[{"x0", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"x", "-", "x0"}], ")"}], "2"]}], " ", 
         RowBox[{"HypergeometricPFQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             FractionBox["3", "2"], ",", "2"}], "}"}], ",", 
           FractionBox[
            RowBox[{"rho", " ", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"x", "-", "x0"}], ")"}], "2"]}], 
            SuperscriptBox["sig", "2"]]}], "]"}]}], "+", 
        RowBox[{
         SuperscriptBox["x0", "2"], " ", 
         RowBox[{"HypergeometricPFQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             FractionBox["3", "2"], ",", "2"}], "}"}], ",", 
           FractionBox[
            RowBox[{"rho", " ", 
             SuperscriptBox["x0", "2"]}], 
            SuperscriptBox["sig", "2"]]}], "]"}]}]}], ")"}]}]}]}]}], 
  "}"}]], "Output",
 CellChangeTimes->{
  3.966850005502214*^9, {3.966850244814658*^9, 3.966850258260181*^9}, 
