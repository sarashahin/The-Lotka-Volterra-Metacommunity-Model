      RowBox[{"results", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Item", "[", 
          RowBox[{"#", ",", 
           RowBox[{"BaseStyle", "->", 
            RowBox[{"{", "\"\<Bold\>\"", "}"}]}]}], "]"}], "&"}], "/@", 
        RowBox[{"{", 
         RowBox[{"\"\<b\>\"", ",", "\"\<Exact Value\>\"", 
          ",", "\"\<Approx Value\>\"", ",", "\"\<Abs. Error\>\"", 
          ",", "\"\<Rel. Error\>\""}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
