Cell[BoxData[
 RowBox[{"x0", "+", 
  FractionBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["x0", "2"], 
       RowBox[{"2", " ", 
        SuperscriptBox["SD", "2"]}]]}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SqrtBox[
        FractionBox["2", "\[Pi]"]], " ", "SD"}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         SuperscriptBox["x0", "2"], 
         RowBox[{"2", " ", 
