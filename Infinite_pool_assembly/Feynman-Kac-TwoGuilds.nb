  RowBox[{
   RowBox[{
    RowBox[{"bMin", "=", 
     RowBox[{"-", "6.0"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bMax", "=", "10.0"}], ";"}], " ", "\n", 
   RowBox[{
    RowBox[{"numPoints", "=", "4000"}], ";"}], "\n", 
   RowBox[{"SetDirectory", "[", 
    RowBox[{"NotebookDirectory", "[", "]"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dataFilename", "=", "\"\<mfpt_lookup_data.mx\>\""}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
