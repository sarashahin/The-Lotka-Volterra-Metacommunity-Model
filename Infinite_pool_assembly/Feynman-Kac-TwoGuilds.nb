     RowBox[{"\"\<Proportion of High arrivals\>\"", ",", 
      " ", "\"\<Mean Abundance Load\>\""}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"loadLow", "=", 
  RowBox[{"Interpolation", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"highProportion", ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "highProportion"}], ")"}], "*", "intMSFull"}], "/.",
         "x0Rule"}], "/.", 
       RowBox[{"s", "->", "lowS"}]}]}], "}"}], "/.", "table"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"loadHigh", "=", 
