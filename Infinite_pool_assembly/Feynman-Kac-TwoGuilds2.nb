Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
  "(*", "************************************************************************)"}\
], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"STEP", " ", "2"}], ":", 
    RowBox[{
     RowBox[{"GENERATE", " ", "OR", " ", "LOAD", " ", "PRE"}], "-", 
