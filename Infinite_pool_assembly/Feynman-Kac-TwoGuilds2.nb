   RowBox[{
   "(*", "************************************************************************)"}\
], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"STEP", " ", "3"}], ":", 
     RowBox[{
     "CREATE", " ", "THE", " ", "FAST", " ", "HYBRID", " ", "FUNCTION", " ", 
      RowBox[{"(", "UNCHANGED", ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
   "(*", "************************************************************************)"}\
], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"splineFunction", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"bValues", ",", "tValues"}], "}"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"asymptoticFormula", "[", "b_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", "*", "Pi"}], "]"}], "/", "b"}], ")"}], "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"b", "^", "2"}], "/", "2"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"mfptLowerTail", "[", 
      RowBox[{"b_", "?", "NumericQ"}], "]"}], "=", 
     RowBox[{
      RowBox[{"Assuming", "[", 
       RowBox[{
        RowBox[{"b", "<", "1"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sqrt", "[", "Pi", "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "*", 
             RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}]}], ")"}], "*", 
         RowBox[{"Integrate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"x", "^", "2"}], "/", "2"}], "]"}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Series", "[", 
                RowBox[{
                 RowBox[{"Erfc", "[", 
                  RowBox[{
                   RowBox[{"-", "x"}], "/", 
                   RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"x", ",", 
                   RowBox[{"-", "Infinity"}], ",", "5"}], "}"}]}], "]"}], "//",
                "Normal"}], ")"}], "^", "2"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"-", "Infinity"}], ",", "b"}], "}"}]}], "]"}]}]}], "]"}],
       "//", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fastMFPT", "[", 
      RowBox[{"b_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"b", "<", "bMin"}], ",", 
       RowBox[{"mfptLowerTail", "[", "b", "]"}], ",", 
       RowBox[{"b", ">", "bMax"}], ",", 
       RowBox[{"asymptoticFormula", "[", "b", "]"}], ",", "True", ",", 
       RowBox[{"splineFunction", "[", "b", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fastMFPT", "[", "b_List", "]"}], ":=", 
     RowBox[{"fastMFPT", "/@", "b"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
   "(*", "************************************************************************)"}\
], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"STEP", " ", "4"}], ":", 
     RowBox[{"WIDE", "-", 
      RowBox[{"RANGE", " ", "ACCURACY", " ", "TEST", " ", 
       RowBox[{"(", "UNCHANGED", ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
   "(*", "************************************************************************)"}\
], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testPoints", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"RandomReal", "[", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"i", "+", "1"}]}], "}"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"-", "12"}], ",", "12"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<\\n--- Wide-Range Accuracy Test (for small b I trust the \
asymptotics, not the -Exact Value-) ---\>\"", ",", "Bold", ",", "14"}], "]"}],
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"results", "=", 
     RowBox[{"Monitor", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "valExact", ",", "valApprox", ",", "absError", ",", "relError"}], 
            "}"}], ",", 
           RowBox[{
            RowBox[{"valExact", "=", 
             RowBox[{"mfptSingleIntegral", "[", "b", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"valApprox", "=", 
             RowBox[{"fastMFPT", "[", "b", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"absError", "=", 
             RowBox[{"Abs", "[", 
              RowBox[{"valExact", "-", "valApprox"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"relError", "=", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"valExact", "!=", "0"}], ",", 
               RowBox[{"absError", "/", "valExact"}], ",", "0"}], "]"}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{
             "b", ",", "valExact", ",", "valApprox", ",", "absError", ",", 
              "relError"}], "}"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"b", ",", "testPoints"}], "}"}]}], "]"}], ",", 
       RowBox[{"StringForm", "[", 
        RowBox[{"\"\<Testing b = ``\>\"", ",", 
         RowBox[{"N", "[", 
          RowBox[{"b", ",", "4"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tableData", "=", 
     RowBox[{"Prepend", "[", 
      RowBox[{"results", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Item", "[", 
          RowBox[{"#", ",", 
           RowBox[{"BaseStyle", "->", 
            RowBox[{"{", "\"\<Bold\>\"", "}"}]}]}], "]"}], "&"}], "/@", 
        RowBox[{"{", 
         RowBox[{"\"\<b\>\"", ",", "\"\<Exact Value\>\"", 
          ",", "\"\<Approx Value\>\"", ",", "\"\<Abs. Error\>\"", 
          ",", "\"\<Rel. Error\>\""}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Grid", "[", 
      RowBox[{"tableData", ",", 
       RowBox[{"Frame", "->", "All"}], ",", 
       RowBox[{"Spacings", "->", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1"}], "}"}]}], ",", 
