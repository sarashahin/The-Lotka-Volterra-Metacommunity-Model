Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["x0", "2"], 
       RowBox[{"2", " ", 
        SuperscriptBox["SD", "2"]}]]}]], " ", 
    SqrtBox[
     FractionBox["2", "\[Pi]"]], " ", "SD"}], "+", "x0", "+", 
   RowBox[{"x0", " ", 
    RowBox[{"Erf", "[", 
     FractionBox["x0", 
      RowBox[{
       SqrtBox["2"], " ", "SD"}]], "]"}]}], "+", 
   RowBox[{"2", " ", "x0", " ", 
    RowBox[{"fastMFPT", "[", 
     FractionBox["x0", "SD"], "]"}]}]}], 
  RowBox[{"2", " ", "rho"}]]], "Output",
 CellChangeTimes->{3.975643128060635*^9, 3.9758343342759666`*^9},
 CellLabel->
  "Out[120]=",ExpressionUUID->"03d39e8a-6c45-41be-8222-15342504e06c"],

