    RowBox[{"abundanceX1", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"densityX1", "/", "alpha1"}], ")"}], "*", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", "[", 
          RowBox[{"[", "#2", "]"}], "]"}], "&"}], ",", 
        RowBox[{"{", 
