               RowBox[{"-", "x"}], "/", 
               RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}]}], ")"}], "^", 
           "2"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"result", "=", 
         RowBox[{"Integrate", "[", 
          RowBox[{
           RowBox[{"integrand", "[", "x", "]"}], ",", 
