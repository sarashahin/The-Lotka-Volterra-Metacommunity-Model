Cell[BoxData[
 RowBox[{"x0", "+", 
  FractionBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["x0", "2"], 
       RowBox[{"2", " ", 
        SuperscriptBox["SD", "2"]}]]}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SqrtBox[
        FractionBox["2", "\[Pi]"]], " ", "SD"}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         SuperscriptBox["x0", "2"], 
         RowBox[{"2", " ", 
          SuperscriptBox["SD", "2"]}]]], " ", "x0"}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         SuperscriptBox["x0", "2"], 
         RowBox[{"2", " ", 
          SuperscriptBox["SD", "2"]}]]], " ", "x0", " ", 
       RowBox[{"Erf", "[", 
        FractionBox["x0", 
         RowBox[{
          SqrtBox["2"], " ", "SD"}]], "]"}]}]}], ")"}]}], 
   RowBox[{"2", " ", 
    RowBox[{"fastMFPT", "[", 
     FractionBox["x0", "SD"], "]"}]}]]}]], "Output",
