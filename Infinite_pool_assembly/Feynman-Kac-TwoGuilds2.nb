Cell[BoxData[
 RowBox[{"c1RuleM", "=", 
  RowBox[{
   TemplateBox[{"1"},
    "C"], "->", 
   RowBox[{
    RowBox[{"Sqrt", "[", "Pi", "]"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{"rho", " ", 
      RowBox[{
       RowBox[{"x0", "^", "2"}], "/", 
       RowBox[{"sig", "^", "2"}]}]}], "]"}], 
    RowBox[{
