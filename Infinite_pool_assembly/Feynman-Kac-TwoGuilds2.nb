      RowBox[{"{", 
       RowBox[{"\"\<Row\>\"", ",", " ", "\"\<Richness\>\""}], "}"}]}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"theoryRichness", "=", 
