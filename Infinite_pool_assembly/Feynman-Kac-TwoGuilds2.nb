Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "We", " ", "measure", " ", "all", " ", "rates", " ", "in", " ", "units", " ",
     "of", " ", 
    RowBox[{"offspringDispersalRate", "!"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"ii", "=", "1"}], ",", 
     RowBox[{"ii", "<", "1000"}], ",", 
     RowBox[{"ii", "++"}], ",", 
     RowBox[{
      RowBox[{"incoming1", "=", 
       RowBox[{
        RowBox[{"InverseFourier", "[", 
         RowBox[{
          RowBox[{"Fourier", "[", "abundance1", "]"}], "*", 
          "yKernelTransform"}], "]"}], "//", "Chop"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"incoming2", "=", 
       RowBox[{
        RowBox[{"InverseFourier", "[", 
         RowBox[{
          RowBox[{"Fourier", "[", "abundance2", "]"}], "*", 
          "yKernelTransform"}], "]"}], "//", "Chop"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"incoming1", "=", 
       RowBox[{"incoming1", "+", 
        RowBox[{
         RowBox[{
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{"NX", "*", "NY"}], ")"}]}], "/", 
          "stepsPerInvasionAttempt"}], "/", "offspringDispersalRate"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"incoming2", "=", 
       RowBox[{"incoming2", "+", 
        RowBox[{
         RowBox[{
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{"NX", "*", "NY"}], ")"}]}], "/", 
          "stepsPerInvasionAttempt"}], "/", "offspringDispersalRate"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"incoming", "=", 
       RowBox[{"incoming1", "+", "incoming2"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"oneProp", "=", 
       RowBox[{"incoming1", "/", "incoming"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"abundance1", "=", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#1", "[", 
           RowBox[{"[", "#2", "]"}], "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"loadHigh", "[", "oneProp", "]"}], ",", 
              RowBox[{"loadLow", "[", 
               RowBox[{"1", "-", "oneProp"}], "]"}]}], "}"}], "//", 
            "Transpose"}], ",", "env"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"abundance2", "=", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#1", "[", 
           RowBox[{"[", "#2", "]"}], "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"loadLow", "[", "oneProp", "]"}], ",", 
              RowBox[{"loadHigh", "[", 
               RowBox[{"1", "-", "oneProp"}], "]"}]}], "}"}], "//", 
            "Transpose"}], ",", "env"}], "}"}]}], "]"}]}], ";"}]}], 
    "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]"}]}]], "Input",
