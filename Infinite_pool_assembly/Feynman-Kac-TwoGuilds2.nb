   RowBox[{
    RowBox[{
     RowBox[{"mfptSingleIntegral", "[", 
      RowBox[{"b_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"integrand", ",", "result"}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"integrand", "[", "x_", "]"}], ":=", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"x", "^", "2"}]}], "/", "2"}], "]"}], "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"E", "^", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"x", "/", 
                  RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], "^", "2"}], 
               ")"}]}], " ", 
             RowBox[{"Erfc", "[", 
              RowBox[{
               RowBox[{"-", "x"}], "/", 
               RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}]}], ")"}], "^", 
           "2"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"result", "=", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{"integrand", "[", "x", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"-", "Infinity"}], ",", "b"}], "}"}], ",", 
           RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sqrt", "[", "Pi", "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "*", 
             RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}]}], ")"}], "*", 
         "result"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mfptAnalytic", "[", "b_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"integrand", ",", "result"}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"integrand", "[", "x_", "]"}], ":=", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"x", "^", "2"}]}], "/", "2"}], "]"}], "*", 
          RowBox[{
           RowBox[{"(", 
