      RowBox[{"Clock", "@", "Infinity"}], ",", "decayRate"}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"ii", "=", "1"}], ",", 
   RowBox[{"ii", "<", "2000"}], ",", 
   RowBox[{"ii", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lastTotalX1", "=", 
