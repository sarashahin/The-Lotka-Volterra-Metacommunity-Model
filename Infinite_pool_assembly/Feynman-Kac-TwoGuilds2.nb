Cell[BoxData[{
 RowBox[{
  RowBox[{"richnessSim", "=", 
   RowBox[{
    RowBox[{"Import", "[", 
     RowBox[{"\"\<richness_by_type.csv\>\"", ",", " ", 
      RowBox[{"HeaderLines", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}]}]}], "]"}], "//", "Transpose"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"simlationRichness", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"richnessSim", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"richnessSim", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{"Total", "[", 
