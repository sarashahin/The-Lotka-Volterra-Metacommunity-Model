Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"densityX2", "=", 
  RowBox[{"Table", "[", 
   RowBox[{"1", ",", 
    RowBox[{"{", "NY", "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dt", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ii", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PrintTemporary", "@", 
   RowBox[{"Dynamic", "@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Clock", "@", "Infinity"}], ",", "decayRate"}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"ii", "=", "1"}], ",", 
   RowBox[{"ii", "<", "2000"}], ",", 
   RowBox[{"ii", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lastTotalX2", "=", 
     RowBox[{"Total", "[", "densityX2", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"abundanceX2", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"densityX2", "/", "alpha2"}], ")"}], "*", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", "[", 
          RowBox[{"[", "#2", "]"}], "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"loadLow", "[", "oneProp", "]"}], ",", 
             RowBox[{"loadHigh", "[", 
              RowBox[{"1", "-", "oneProp"}], "]"}]}], "}"}], "//", 
           "Transpose"}], ",", "env"}], "}"}]}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"incomingX2", "=", 
     RowBox[{
      RowBox[{"InverseFourier", "[", 
       RowBox[{
        RowBox[{"Fourier", "[", "abundanceX2", "]"}], "*", 
        RowBox[{"Fourier", "[", "yKernel", "]"}]}], "]"}], "//", "Chop"}]}], ";",
     "\[IndentingNewLine]", 
    RowBox[{"colonisationX2", "=", 
     RowBox[{"incomingX2", "*", "pInv2"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"densityX2", "+=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"colonisationX2", " ", "-", " ", 
        RowBox[{"densityX2", "*", "rExt2"}]}], ")"}], "*", "dt"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"decayRate2", "=", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"Total", "[", "densityX2", "]"}], "/", "lastTotalX2"}], "]"}],
       "/", "dt"}]}]}]}], "\[IndentingNewLine]", 
  "]"}], "\[IndentingNewLine]", "decayRate2", "\[IndentingNewLine]", 
 RowBox[{"1", "/", 
  RowBox[{"(", 
   RowBox[{"stepsPerInvasionAttempt", "*", 
    RowBox[{"Abs", "[", "decayRate2", "]"}]}], ")"}]}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"densityX1", "/", 
      RowBox[{"Total", "[", "densityX1", "]"}]}], ",", 
     RowBox[{"densityX2", "/", 
      RowBox[{"Total", "[", "densityX2", "]"}]}]}], "}"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"0", ",", "Automatic"}], "}"}]}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
