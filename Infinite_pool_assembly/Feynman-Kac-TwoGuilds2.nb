  RowBox[{
   RowBox[{"HypergeometricPFQ", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       FractionBox["3", "2"], ",", "2"}], "}"}], ",", "s_"}], "]"}], ":>", 
   RowBox[{
    FractionBox[
     RowBox[{"\[Pi]", " ", 
      RowBox[{"Erf", "[", 
       SqrtBox["s"], "]"}], " ", 
      RowBox[{"Erfi", "[", 
       SqrtBox["s"], "]"}]}], 
     RowBox[{"2", " ", "s"}]], "-", 
    RowBox[{"HypergeometricPFQ", "[", 
